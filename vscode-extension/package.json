{
  "name": "can-vhal-studio",
  "displayName": "CAN-to-AOSP VHAL Mapping Studio",
  "description": "Visual CAN DBC to Android Automotive OS (AOSP) VHAL Mapping Studio with interactive Blueprint node canvas & C++ AIDL code synthesizer.",
  "version": "1.0.0",
  "publisher": "KemisettyHanya",
  "repository": {
    "type": "git",
    "url": "https://github.com/KemisettyHanya/VHAL-CPP.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "can",
    "dbc",
    "vhal",
    "aosp",
    "android",
    "automotive",
    "aidl",
    "node-editor"
  ],
  "activationEvents": [
    "onCommand:canVhalStudio.openStudio",
    "workspaceContains:**/*.dbc",
    "workspaceContains:**/*vhal*.cpp",
    "workspaceContains:**/*Vhal*.cpp"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "canVhalStudio.openStudio",
        "title": "Open Visual Mapping Studio",
        "category": "CAN-to-VHAL",
        "icon": "$(circuit-board)"
      },
      {
        "command": "canVhalStudio.importDbc",
        "title": "Import CAN DBC File...",
        "category": "CAN-to-VHAL",
        "icon": "$(file-code)"
      },
      {
        "command": "canVhalStudio.reconstructFromCpp",
        "title": "Reconstruct Visual Connections from Legacy C++...",
        "category": "CAN-to-VHAL",
        "icon": "$(history)"
      },
      {
        "command": "canVhalStudio.synthesizeCpp",
        "title": "Synthesize AIDL C++ Code into Active File",
        "category": "CAN-to-VHAL",
        "icon": "$(zap)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "canVhalStudio.openStudio",
          "group": "navigation",
          "when": "resourceExtname == .dbc || resourceExtname == .cpp || resourceExtname == .hpp"
        }
      ],
      "explorer/context": [
        {
          "command": "canVhalStudio.openStudio",
          "group": "CAN-to-VHAL",
          "when": "resourceExtname == .dbc || resourceExtname == .cpp"
        }
      ]
    },
    "keybindings": [
      {
        "command": "canVhalStudio.openStudio",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.7.3"
  }
}
