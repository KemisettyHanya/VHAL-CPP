CM_ SG_ 256 WheelSpeedFL "Front Left wheel tangential ground speed in km/h";
CM_ SG_ 256 WheelSpeedFR "Front Right wheel tangential ground speed in km/h";
CM_ SG_ 256 WheelSpeedRL "Rear Left wheel tangential ground speed in km/h";
CM_ SG_ 256 WheelSpeedRR "Rear Right wheel tangential ground speed in km/h";

CM_ BO_ 288 "Chassis inertia and vehicle dynamic motion state";
CM_ SG_ 288 VehicleSpeed "Averaged longitudinal ground velocity";
CM_ SG_ 288 SteeringWheelAngle "Handwheel position in degrees";
CM_ SG_ 288 YawRate "Chassis rotation about vertical axis";

CM_ BO_ 320 "Hydraulic and electronic brake system sensors";
CM_ SG_ 320 BrakePedalPosition "Driver brake pedal depression percentage";
CM_ SG_ 320 BrakeMasterPressure "Hydraulic master cylinder pressure in bar";

CM_ BO_ 512 "Internal combustion engine operating parameters";
CM_ SG_ 512 EngineRPM "Crankshaft rotational speed in RPM";
CM_ SG_ 512 EngineCoolantTemp "Engine block coolant fluid temperature";
CM_ SG_ 512 FuelLevel "Fuel tank remaining liquid percentage";

CM_ BO_ 640 "Electric vehicle high-voltage traction battery";
CM_ SG_ 640 BatteryStateOfCharge "Battery usable capacity state of charge (SoC)";
CM_ SG_ 640 BatteryVoltage "DC bus voltage of high-voltage pack";
CM_ SG_ 640 BatteryCurrent "Traction pack current (+discharge, -charge)";

CM_ BO_ 768 "Cabin front heating, ventilation, and air conditioning";
