VAL_ 320 ParkingBrakeState 0 "Disengaged" 1 "Engaged" 2 "Applying" 3 "Fault" ;
VAL_ 544 SelectedGear 0 "Park" 1 "Reverse" 2 "Neutral" 3 "Drive" 4 "Sport" 5 "Low" ;
VAL_ 544 TransmissionMode 0 "Normal" 1 "Eco" 2 "Sport" 3 "Snow" 4 "Tow" ;
VAL_ 640 ChargingStatus 0 "NotCharging" 1 "Connected" 2 "ChargingAC" 3 "ChargingDC" 4 "ChargingComplete" 5 "Fault" ;
VAL_ 1280 AdaptiveCruiseControlState 0 "Off" 1 "Standby" 2 "Active" 3 "Override" 4 "Braking" 5 "Fault" ;

